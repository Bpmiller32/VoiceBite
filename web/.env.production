# Baked into the bundle at build time by Vite.
# The frontend is served from Firebase Hosting; the API stays on the Pi behind the
# existing Cloudflare Tunnel, so this is the only thing that points one at the other.
VITE_API_BASE=https://voicebite.billmill.dev

# Fallback user id, used only before sign-in (and by the header while the session loads).
# Once signed in the client uses the id the server returns at login, so this no longer has to
# stay in lockstep with the server's DEFAULT_USER.
VITE_USER=billy
