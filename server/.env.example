# Your Anthropic API key - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model to use.
# Structured outputs and the server-side web tools both need Opus 5 or newer.
CLAUDE_MODEL=claude-opus-5

# How hard Claude thinks when parsing a meal into items and working out portions.
# low | medium | high | xhigh | max. This is the reasoning-heavy call - it decides what
# you ate and how much of it - so it is the one worth spending on.
CLAUDE_EFFORT=medium

# Effort for a grounding lookup, which is a different job: reading a number off a page
# that has already been identified. Retrieval, not reasoning. Running lookups at the parse
# effort spent the whole wall-clock budget on two items and grounded neither.
CLAUDE_LOOKUP_EFFORT=medium

# Effort for `npm run backfill`, which resolves your repeat foods in bulk. Defaults to
# medium. Bulk work is the one place where turning this down is cheap: a backfill run is
# many independent lookups, so a slower per-item result costs you nothing but wall clock.
CLAUDE_BACKFILL_EFFORT=medium

# Ceiling on generated tokens per call. Not a spend cap - you only pay for what is
# produced - so a high value costs nothing unless a response genuinely needs the room.
CLAUDE_MAX_TOKENS=32000

# Read published nutrition facts for branded items instead of recalling them.
# This is what corrects the largest measured error in the app: 78% of logged calories come
# from products that publish exact figures. Set to "off" to fall back to pure estimation,
# which is useful for measuring what grounding actually buys.
VOICEBITE_GROUNDING=on

# Fill in the micronutrients no nutrition label prints - magnesium, zinc, selenium, B6,
# folate, vitamin E and so on - by reasoning from the food's composition once its identity
# and portion mass are settled. Roughly doubles per-item micronutrient coverage, and
# roughly doubles the time. Set to "off" to measure its contribution.
VOICEBITE_MICRO_PASS=on

# Wall-clock ceiling for one POST /log, measured from the start of the parse call.
# A hard infrastructure limit, not a comfort setting: the web client aborts at 95s and the
# Cloudflare Tunnel's origin timeout is around 100s. A 524 reaches the user as
# "Can't reach the server" - a bad message for a Pi that is working perfectly.
VOICEBITE_BUDGET_MS=80000

# The default user for CLI usage (used as the folder name under data/users/)
DEFAULT_USER=billy

# Where to store daily food log JSON files
# Defaults to ./data if not set
DATA_DIR=./data

# Port for the HTTP server (used when running `npm run server`)
PORT=3000

# --- Auth -------------------------------------------------------------------------------
# One password, one user. Generate BOTH of the lines below in one go:
#
#   npm run set-password -- "your new password"
#
# It prints an AUTH_PASSWORD_HASH and a fresh AUTH_SECRET to paste here. The password
# itself is never stored - only the scrypt hash.
#
# Without both set, every authenticated route returns 503 rather than falling open. An
# unconfigured gate that silently allows everything looks protected and isn't.
AUTH_PASSWORD_HASH=scrypt$...$...

# Signs bearer tokens (HMAC-SHA256). Must be at least 32 characters or the server throws
# on the first login. Changing it invalidates every issued token, i.e. signs out every
# device - which is also how you revoke access in a hurry.
AUTH_SECRET=

# CORS allow-list, comma-separated. Not a security control - curl and server-to-server
# calls send no Origin and bypass it entirely - it exists so the browser can reach the API.
#
# It must contain the EXACT origin the browser sends. Firebase serves one Hosting site at
# both <site-id>.web.app and <site-id>.firebaseapp.com, so both belong here, and the
# hostname comes from the SITE id, not the project id. A missing entry is indistinguishable
# from "the server is down" in the UI; rejected origins are logged with the origin that
# asked, which turns that into a ten-second diagnosis.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://voicebite.web.app,https://voicebite.firebaseapp.com

# --- Logging ----------------------------------------------------------------------------
# Where pino writes its JSON log file. Defaults to ./logs
LOG_DIR=./logs

# trace | debug | info | warn | error | fatal. Defaults to info.
LOG_LEVEL=info
