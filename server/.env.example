# Your Anthropic API key - get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Which Claude model to use - update this string when Anthropic releases newer models
# Latest as of 2026: claude-sonnet-4-6 (Sonnet is the sweet spot of speed vs quality)
# Full model list: https://docs.anthropic.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-sonnet-4-6

# Your USDA FoodData Central API key - free instant signup at https://api.data.gov/signup
USDA_FDC_API_KEY=your-fdc-key-here

# The default user for CLI usage (used as the folder name under data/users/)
DEFAULT_USER=billy

# Where to store daily food log JSON files
# Defaults to ./data if not set
DATA_DIR=./data

# Port for the HTTP server (used when running `npm run server`)
PORT=3000
